# Core
OUTREACH_DATABASE_PATH=./data/outreach.sqlite3
OUTREACH_PLAYBOOK=procurement
OUTREACH_LOG_LEVEL=INFO

# AI provider (optional; the offline demo does not need these)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional split: keep extraction cheap and use a stronger model for bid drafting.
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_DRAFTING_MODEL=gpt-5.4-mini

# Public tender-pack retrieval (used only by the procurement playbook)
OUTREACH_RETRIEVAL_ENABLED=false
OUTREACH_WEB_DISCOVERY_ENABLED=false
OUTREACH_DOCUMENT_PATH=./data/private/documents
OUTREACH_ARTIFACT_PATH=./data/private/artifacts
# Node 20+ is used only to create editable Word and Excel downloads.
OUTREACH_ARTIFACT_NODE=node
OUTREACH_CRAWL_MAX_PAGES=12
OUTREACH_CRAWL_MAX_DEPTH=2
OUTREACH_CRAWL_MAX_RESOURCE_MB=10
OUTREACH_CRAWL_MAX_TOTAL_MB=30

# Gmail connector (optional)
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json
GMAIL_TOKEN_PATH=./gmail_token.json
GMAIL_LABEL=Tender Alerts
GMAIL_QUERY='subject:"Find a Tender"'

# Local review console
OUTREACH_HOST=127.0.0.1
OUTREACH_PORT=8080
